{
    "name": "danipa/sdk",
    "description": "Official PHP SDK for the Danipa fintech API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.danipa.com",
    "support": {
        "issues": "https://github.com/danipa/php-sdk/issues",
        "source": "https://github.com/danipa/php-sdk"
    },
    "keywords": ["danipa", "fintech", "payments", "africa", "momo", "sdk"],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Danipa\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danipa\\Sdk\\Tests\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover coverage/clover.xml --coverage-text",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs --standard=PSR12 src test",
        "phpcbf": "phpcbf --standard=PSR12 src test",
        "lint": ["@phpstan", "@phpcs"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
