{
    "name": "danipa/sdk",
    "description": "Official PHP SDK for the Danipa fintech API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Danipa/php-sdk",
    "support": {
        "issues": "https://github.com/Danipa/php-sdk/issues",
        "source": "https://github.com/Danipa/php-sdk",
        "docs": "https://github.com/Danipa/php-sdk#readme"
    },
    "keywords": ["danipa", "fintech", "payments", "africa", "momo", "sdk", "psr-18"],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "composer-runtime-api": "^2.0",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client + PSR-17 factories; auto-discovered when installed. Any other PSR-18 client (Symfony HttpClient, Buzz, ...) works too."
    },
    "autoload": {
        "psr-4": {
            "Danipa\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danipa\\Sdk\\Tests\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-clover coverage/clover.xml --coverage-text",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "phpcs": "phpcs --standard=PSR12 src test",
        "phpcbf": "phpcbf --standard=PSR12 src test",
        "lint": ["@phpstan", "@phpcs"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
